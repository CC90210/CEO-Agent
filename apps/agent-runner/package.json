{
  "name": "oasis-agent-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent Hetzner-hosted runner for the OASIS Agent Command Center chat widget.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.1",
    "dotenv": "^17.2.3",
    "ignore": "^7.0.5",
    "jose": "^5.10.0",
    "libsodium-wrappers": "^0.7.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
