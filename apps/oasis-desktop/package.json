{
  "name": "oasis-ai-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OASIS AI Desktop - local runtime shell for the Agent Command Center.",
  "author": "OASIS AI Solutions <conaugh@oasisai.work>",
  "homepage": "https://agent-dashboard-cc90210.vercel.app/download",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "doctor": "node scripts/doctor.js",
    "auth:check": "node scripts/auth-navigation-check.js",
    "release:check": "node scripts/release-check.js",
    "release:metadata": "node scripts/write-release-metadata.js",
    "release:asset-check": "node scripts/check-release-assets.js",
    "artifact:check": "node scripts/artifact-check.js",
    "portable:win": "node scripts/create-windows-portable.js",
    "signing:check": "node scripts/signing-status.js",
    "sign:mac:adhoc": "bash scripts/adhoc-sign-mac.sh",
    "bundle:sidecar": "node scripts/bundle-sidecar.js",
    "bundle:hardblock-test": "node scripts/test-bundle-hardblock.js",
    "prepack": "node scripts/bundle-sidecar.js",
    "pack": "electron-builder --dir",
    "build:win": "npm run bundle:sidecar && electron-builder --win nsis",
    "build:linux": "npm run bundle:sidecar && electron-builder --linux AppImage deb",
    "build:mac": "npm run bundle:sidecar && electron-builder --mac dmg zip",
    "build:free": "node scripts/build-free.js"
  },
  "build": {
    "appId": "ai.oasis.commandcenter",
    "productName": "OASIS AI",
    "artifactName": "OASIS-AI-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "scripts/**/*",
      "desktop.manifest.json",
      "README.md",
      "RELEASE.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/sidecar",
        "to": "sidecar",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OASIS AI"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Office",
      "maintainer": "OASIS AI Solutions <conaugh@oasisai.work>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  }
}
