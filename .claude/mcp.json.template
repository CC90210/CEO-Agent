{
  "//": "MCP server config template — copied to .claude/mcp.json by the installer. Use ${REPO_ROOT} for the repo path and ${USER_HOME} for the user's home; the installer substitutes them at copy time. The .js shim scripts in scripts/mcp_shims/ read tokens from .env.agents at runtime; no credentials live here. Last synced with live mcp.json: 2026-05-21 (9 servers).",
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "github": {
      "command": "node",
      "args": ["scripts\\mcp_shims\\github.js"]
    },
    "firecrawl": {
      "command": "node",
      "args": ["scripts\\mcp_shims\\firecrawl.js"]
    },
    "obsidian": {
      "command": "node",
      "args": ["scripts\\mcp_shims\\obsidian.js"]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${REPO_ROOT}",
        "${USER_HOME}\\APPS",
        "${USER_HOME}\\.claude"
      ]
    },
    "knowledge-graph": {
      "command": "npx",
      "args": [
        "tsx",
        "${USER_HOME}\\tools\\knowledge-graph\\src\\mcp\\index.ts"
      ],
      "env": {
        "KG_VAULT_PATH": "${REPO_ROOT}",
        "KG_DATA_DIR": "${USER_HOME}\\tools\\knowledge-graph\\data"
      }
    }
  }
}
