# Bravo V6.0 — Caddy reverse proxy
#
# Public entrypoint for webhooks (N8N, Stripe, Telegram) + an optional
# admin endpoint for CC. HTTPS via automatic Let's Encrypt.
#
# Replace OPS_DOMAIN with the actual FQDN you point at the VPS, e.g.,
# ops.oasisai.work. The email is required by Let's Encrypt for cert renewal
# notices — use Konamak@icloud.com or a dedicated alias.

{
    email {$CADDY_ACME_EMAIL:Konamak@icloud.com}
    # Stricter defaults: disable OCSP stapling leaks, block HTTP/3 if unstable
    # servers_policy internal  # uncomment if you want internal CA for staging
}

# ── Production webhook endpoint ───────────────────────────────────────────
{$OPS_DOMAIN:ops.oasisai.work} {
    encode zstd gzip
    log {
        output file /data/logs/access.log {
            roll_size 10mb
            roll_keep 10
        }
    }

    # Rate-limit aggressively — this endpoint receives webhooks, not humans.
    # Legitimate sources (Stripe, N8N, Telegram) are well under these caps.
    @abuse {
        path /healthz
        not remote_ip private_ranges
    }

    handle /healthz {
        respond "ok" 200
    }

    # Stripe webhook: verified by Stripe signature inside scripts/webhook_listener.py
    handle /webhooks/stripe* {
        reverse_proxy bravo-webhook:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # N8N inbound lead / form webhooks.
    handle /webhooks/n8n* {
        reverse_proxy bravo-webhook:8000
    }

    # Telegram webhook (if we move off long-polling).
    handle /webhooks/telegram* {
        reverse_proxy bravo-webhook:8000
    }

    # Catch-all: 404 anything not explicitly routed.
    handle {
        respond "not found" 404
    }

    # Security headers baseline.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }
}

# ── Redirect http → https automatically (Caddy does this by default but
#     being explicit lets CC see the config) ──────────────────────────────
http://{$OPS_DOMAIN:ops.oasisai.work} {
    redir https://{host}{uri} permanent
}

# ── Command Center (V6.0) ────────────────────────────────────────────────
# Public TLS-terminated entry point for the Next.js dashboard.
# Basic auth gates everything; Supabase Auth runs inside the app for the
# tenant model. Belt + suspenders.
#
# Required env vars (setup_wizard step_v6_init writes these):
#   DASHBOARD_DOMAIN     e.g. dashboard.client.example.com
#   DASHBOARD_USER       basic-auth username
#   DASHBOARD_BCRYPT     output of `caddy hash-password --plaintext '<pw>'`
{$DASHBOARD_DOMAIN:dashboard.oasisai.work} {
    encode zstd gzip
    log {
        output file /data/logs/dashboard-access.log {
            roll_size 10mb
            roll_keep 10
        }
    }

    # `handle` blocks are mutually exclusive — at most one matches per
    # request, so the basicauth inside the second block does NOT leak
    # to the first. This is the correct Caddy idiom for "auth on
    # everything except X". (A top-level `basicauth /*` would apply
    # to the carve-out too, which was the bug fixed 2026-05-10.)
    @health path /api/health

    handle @health {
        reverse_proxy command-center:3000
    }

    handle {
        basicauth {
            {$DASHBOARD_USER} {$DASHBOARD_BCRYPT}
        }
        reverse_proxy command-center:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }
}

http://{$DASHBOARD_DOMAIN:dashboard.oasisai.work} {
    redir https://{host}{uri} permanent
}
