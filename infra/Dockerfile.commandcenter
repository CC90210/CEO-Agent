# Bravo V6.0 — Next.js 15 Command Center
# Multi-stage build → small final image, non-root, read-only rootfs compatible.
# ────────────────────────────────────────────────────────────────────────

FROM node:20-alpine AS deps
WORKDIR /app
# Copy lockfile first so dependency layer caches across code changes.
COPY apps/command-center/package.json apps/command-center/package-lock.json* ./
RUN npm ci --omit=dev --no-audit --no-fund

# ── Build ───────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY apps/command-center ./
# Standalone output puts every runtime dep in .next/standalone — required
# for the small runtime image below.
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ── Runtime ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Non-root runtime user. UID 10001 matches the bravo user in infra/Dockerfile
# so volume permissions stay consistent across the stack.
RUN addgroup -g 10001 -S nextjs \
 && adduser  -u 10001 -G nextjs -S -s /sbin/nologin nextjs \
 && mkdir -p /app/.next/cache \
 && chown -R nextjs:nextjs /app

WORKDIR /app

# Standalone output: server.js + node_modules trimmed to runtime deps only.
COPY --from=builder --chown=nextjs:nextjs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /app/.next/static     ./.next/static

# `public/` is optional — Command Center may not have one. The /bin/true
# fallback keeps the build green if the directory is absent.
RUN mkdir -p /app/public
COPY --from=builder --chown=nextjs:nextjs /app/public           /app/public

USER nextjs
EXPOSE 3000

# Lightweight curl probe to Next's auto health endpoint.
HEALTHCHECK --interval=60s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3000/api/health || exit 1

CMD ["node", "server.js"]
