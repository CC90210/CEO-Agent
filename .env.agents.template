# == V6 SUBSTRATE: Guard Modes ==============================================
# EMPIRE_V6_MODE: off | shadow | on
#   off  = V6 pillars disabled (fallback to V5 behavior)
#   shadow = guards log-only, no blocking (soak mode)
#   on   = full enforcement (production)
EMPIRE_V6_MODE=shadow

# EMPIRE_HOOK_SECRET_GUARD: report | enforce
#   report = log blocked secret access attempts
#   enforce = hard-block reads on .env*, *.pem, *.key, credentials.json
EMPIRE_HOOK_SECRET_GUARD=report

# EMPIRE_HOOK_EXEC_GUARD: report | enforce
#   report = log blocked destructive commands
#   enforce = hard-block DROP, DELETE-without-WHERE, rm -rf, force-push
EMPIRE_HOOK_EXEC_GUARD=report

# EMPIRE_HOOK_STATE_GUARD: off | report | enforce
#   off    = no state file protection
#   report = log blocked edits on auto-generated state mirrors
#   enforce = hard-block edits on auto-generated state mirrors
EMPIRE_HOOK_STATE_GUARD=off

# == V6 SUBSTRATE: HMAC Keys (exec override approvals) ======================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OASIS_OUTBOUND_HMAC_SECRET=EXAMPLE-HMAC-SECRET-REPLACE-ME
EMPIRE_OVERRIDE_HMAC_KEY=EXAMPLE-HMAC-KEY-REPLACE-ME

# == V6 SUBSTRATE: Browser Harness ==========================================
