+"""CDP WS holder + socket relay. One daemon per BU_NAME."""
+import asyncio, hashlib, json, os, socket, sys, tempfile, time, urllib.request
@@ -24,3 +24,6 @@ NAME = os.environ.get("BU_NAME", "default")
-SOCK = f"/tmp/bu-{NAME}.sock"
-LOG = f"/tmp/bu-{NAME}.log"
-PID = f"/tmp/bu-{NAME}.pid"
+TMP = Path(tempfile.gettempdir())
+USE_UNIX_SOCKET = hasattr(socket, "AF_UNIX") and os.name != "nt"
+PORT = 46000 + (int(hashlib.sha256(NAME.encode()).hexdigest()[:8], 16) % 10000)
+SOCK = f"/tmp/bu-{NAME}.sock" if USE_UNIX_SOCKET else f"127.0.0.1:{PORT}"
+LOG = f"/tmp/bu-{NAME}.log" if USE_UNIX_SOCKET else str(TMP / f"bu-{NAME}.log")
+PID = f"/tmp/bu-{NAME}.pid" if USE_UNIX_SOCKET else str(TMP / f"bu-{NAME}.pid")
@@ -195 +198 @@ async def serve(d):
-    if os.path.exists(SOCK):
+    if USE_UNIX_SOCKET and os.path.exists(SOCK):
@@ -215,2 +218,5 @@ async def serve(d):
-    server = await asyncio.start_unix_server(handler, path=SOCK)
-    os.chmod(SOCK, 0o600)
+    if USE_UNIX_SOCKET:
+        server = await asyncio.start_unix_server(handler, path=SOCK)
+        os.chmod(SOCK, 0o600)
+    else:
+        server = await asyncio.start_server(handler, host="127.0.0.1", port=PORT)
@@ -230,3 +236,8 @@ def already_running():
-        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(1)
-        s.connect(SOCK); s.close(); return True
-    except (FileNotFoundError, ConnectionRefusedError, socket.timeout):
