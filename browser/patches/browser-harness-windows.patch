diff --git a/daemon.py b/daemon.py
index bf99d4d..f47b431 100644
--- a/daemon.py
+++ b/daemon.py
@@ -1,2 +1,2 @@
-"""CDP WS holder + Unix socket relay. One daemon per BU_NAME."""
