{
  "name": "ceo-agent",
  "version": "1.0.0",
  "description": "> Autonomous AI operations hub for CC's business empire. Manages codebases, deployments, content pipelines, and business operations across OASIS AI Solutions, PropFlow, and Nostalgic Requests.",
  "main": "index.js",
  "scripts": {
    "test": "python scripts/run_tests.py -v",
    "test:quiet": "python scripts/run_tests.py -q",
    "test:fast": "python scripts/run_tests.py -q -x",
    "test:coverage": "python scripts/run_tests.py --cov=scripts --cov-report=term-missing",
    "lint": "ruff check scripts/",
    "lint:fix": "ruff check --fix scripts/",
    "lint:format": "ruff format scripts/",
    "typecheck": "mypy scripts/ --ignore-missing-imports",
    "verify-deploy": "python scripts/deploy/verify_deploy.py",
    "verify-deploy:quick": "python scripts/deploy/verify_deploy.py --quick",
    "health": "python scripts/state/health_aggregator.py",
    "security-audit": "python scripts/security_audit.py scan",
    "backup": "python scripts/state/backup_db.py backup --keep 7",
    "changelog": "python scripts/generate_changelog.py",
    "telegram": "node telegram_agent.js",
    "telegram:bg": "node telegram_agent.js >> telegram_bot.log 2>&1",
    "ai:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai_workstation_doctor.ps1",
    "ai:operator": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai_operator.ps1",
    "ai:services": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai_operator.ps1 services",
    "ai:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai_operator.ps1 logs",
    "ai:performance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai_operator.ps1 performance",
    "ai:security-events": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai_operator.ps1 security-events",
    "ai:tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai_operator.ps1 tools",
    "ai:upgrade-plan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai_operator.ps1 upgrade-plan",
    "browser:doctor": "python scripts/browser/browser_harness_doctor.py",
    "browser:setup": "powershell -NoProfile -Command \"& (Get-Command browser-harness).Source --setup\"",
    "onboarding:doctor": "python scripts/onboarding_diagnostics.py",
    "gateway": "node gateway/index.js",
    "gateway:bg": "node gateway/index.js >> gateway/gateway.log 2>&1",
    "gateway:admin": "python scripts/gateway_admin.py",
    "desktop:doctor": "npm --prefix apps/oasis-desktop run doctor",
    "desktop:auth-check": "npm --prefix apps/oasis-desktop run auth:check",
    "desktop:release-check": "npm --prefix apps/oasis-desktop run release:check",
    "desktop:release-metadata": "npm --prefix apps/oasis-desktop run release:metadata",
    "desktop:artifact-check": "npm --prefix apps/oasis-desktop run artifact:check",
    "desktop:portable:win": "npm --prefix apps/oasis-desktop run portable:win",
    "desktop:signing-check": "npm --prefix apps/oasis-desktop run signing:check",
    "desktop:dev": "npm --prefix apps/oasis-desktop start",
    "desktop:pack": "npm --prefix apps/oasis-desktop run pack",
    "desktop:build:win": "npm --prefix apps/oasis-desktop run build:win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CC90210/CEO-Agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CC90210/CEO-Agent/issues"
  },
  "homepage": "https://github.com/CC90210/CEO-Agent#readme",
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@notionhq/client": "^5.11.0",
    "@remotion/cli": "^4.0.431",
    "@remotion/renderer": "^4.0.431",
    "@supabase/supabase-js": "^2.98.0",
    "dotenv": "^17.3.1",
    "@slack/bolt": "^3.22.0",
    "discord.js": "^14.16.0",
    "node-telegram-bot-api": "^0.67.0",
    "playwright": "^1.58.2",
    "remotion": "^4.0.431"
  },
  "overrides": {
    "form-data": "^2.5.4",
    "tough-cookie": "^4.1.4",
    "qs": "^6.14.0",
    "uuid": "^14.0.0",
    "fast-uri": "^3.1.2",
    "request": "npm:@cypress/request@^3.0.8",
    "ws": "^8.20.1",
    "brace-expansion": "^5.0.9"
  }
}
