# Bravo - Autonomous AI Business Agent
# Environment variable template
#
# USAGE:
#   Run the setup wizard:  bravo setup
#   Or copy manually:      cp .env.example .env.agents  then fill in values
#   Never commit .env.agents -- it is gitignored
#
# LEGEND:  [REQUIRED] cannot start without  [CORE] major feature loss  [OPTIONAL] safe to skip
# All example values are fake. Replace every EXAMPLE-REPLACE-ME before use.

# == REQUIRED CORE: AI Provider =============================================
# Anthropic Claude (main reasoning engine)
# Get at: https://console.anthropic.com/account/keys   Format: sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-api03-EXAMPLE-REPLACE-ME

# OpenAI (Codex delegation + mem0ai embeddings)
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-EXAMPLE-REPLACE-ME
OPENAI_ORG_ID=

# Google Gemini (Atlas CFO Agent path)
# Get at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=AIzaSyEXAMPLE-REPLACE-ME


# == REQUIRED CORE: Database (Supabase) =====================================
# Create a project at: https://supabase.com/dashboard
# All values: Supabase Dashboard > Settings > API
SUPABASE_URL=https://abcdefghijklmnop.supabase.co
BRAVO_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EXAMPLE-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EXAMPLE-SERVICE-ROLE-KEY
BRAVO_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EXAMPLE-SERVICE-ROLE-KEY
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EXAMPLE-SERVICE-ROLE-KEY
SUPABASE_SERVICE_ROLE_KEY_BRAVO=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EXAMPLE-SERVICE-ROLE-KEY
# Management token (expires every 30 days) -- https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_EXAMPLE-MANAGEMENT-TOKEN
SUPABASE_PROJECT_ID=abcdefghijklmnop


# == REQUIRED CORE: Notifications (Telegram) ================================
# Create bot via @BotFather, get chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOPQRSTUV-EXAMPLE
TELEGRAM_CHAT_ID=987654321
TELEGRAM_ALLOWED_USERS=987654321


# == CORE: Revenue and Billing (Stripe) =====================================
# https://dashboard.stripe.com/apikeys  (sk_test_ during setup, sk_live_ in prod)
STRIPE_SECRET_KEY=sk_test_EXAMPLE-REPLACE-ME
STRIPE_WEBHOOK_SECRET=whsec_EXAMPLE-REPLACE-ME
STRIPE_PUBLISHABLE_KEY=pk_test_EXAMPLE-REPLACE-ME


# == CORE: Email and Google Workspace =======================================
# OAuth handled by: gws auth login  (no OAuth tokens stored here)
GOOGLE_WORKSPACE_EMAIL=you@yourdomain.com
GMAIL_USER=you@yourdomain.com
GMAIL_ADDRESS=you@yourdomain.com
# Gmail App Password (SMTP fallback) -- https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx


# == CORE: Web Scraping (Firecrawl) =========================================
# https://www.firecrawl.dev  Format: fc-...
FIRECRAWL_API_KEY=fc-EXAMPLE-REPLACE-ME


# == CORE: Workflow Automation (n8n) ========================================
N8N_API_URL=https://n8n.yourdomain.com/api/v1
N8N_API_KEY=n8n-api-EXAMPLE-REPLACE-ME


# == CORE: Social Media Scheduling (Zernio) =================================
# Variable kept as LATE_API_KEY after Late -> Zernio rebrand
# Get at: https://zernio.com/dashboard/settings/api
LATE_API_KEY=EXAMPLE-REPLACE-ME


# == CORE: Community Automation (Skool) =====================================
# No API key -- session-based. Run: python scripts/skool_engine.py login
SKOOL_COMMUNITY_SLUG=your-community-slug


# == CORE: Version Control (GitHub) =========================================
# https://github.com/settings/tokens/new  Scopes: repo, workflow, read:org
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_EXAMPLE-REPLACE-ME


# == CORE: DNS and CDN (Cloudflare) =========================================
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=EXAMPLE-REPLACE-ME
CLOUDFLARE_TOKEN=EXAMPLE-REPLACE-ME


# == CORE: Deployment (Vercel) ==============================================
# https://vercel.com/account/tokens
VERCEL_API_TOKEN=EXAMPLE-REPLACE-ME
VERCEL_TOKEN=EXAMPLE-REPLACE-ME


# == OPTIONAL: Media Generation =============================================
# ElevenLabs voice generation -- https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=EXAMPLE-REPLACE-ME


# == OPTIONAL: Chat Bridges =================================================
# Slack: https://api.slack.com/apps > OAuth and Permissions  Format: xoxb-...
SLACK_BOT_TOKEN=xoxb-EXAMPLE-REPLACE-ME
# Discord: https://discord.com/developers/applications > Bot
DISCORD_TOKEN=EXAMPLE-REPLACE-ME


# == OPTIONAL: CRM Enrichment ===============================================
HUBSPOT_API_KEY=EXAMPLE-REPLACE-ME
APOLLO_API_KEY=EXAMPLE-REPLACE-ME


# == IDENTITY AND PERSONALIZATION ==========================================
# Set interactively by the setup wizard. Edit here to override.
CASL_SENDER_NAME=Your Full Name
OPERATOR_EMAIL=you@yourdomain.com
CASL_BUSINESS_NAME=Your Business Name
CASL_BUSINESS_ADDRESS=123 Main St, City, Province, Postal Code
BOOKING_LINK=https://calendar.app.google/yourlink
BOOKING_MEET_LINK=https://meet.google.com/yourlink
WEBSITE_LINK=https://yourdomain.com


# == AGENT RUNTIME: Tunable Limits =========================================
HOURLY_CAP=10
BRAVO_AGENT_LABEL=Bravo
BRAVO_SESSION_ID=
BRAVO_FORCE_DRY_RUN=0
GATEWAY_CONTROL_PORT=9753
SENDER_REPUTATION=0.95
STATE_SYNC_AGENT=bravo


# == SIBLING REPO PATHS ====================================================
# Absolute paths to sibling agent repos. Set by wizard when you clone siblings.
ATLAS_REPO=
MAVEN_REPO=
AURA_REPO=
BRAVO_REPO=


# == CLIENT TENANCY (clone mode only) =====================================
# Populated when Bravo is deployed for a client. Leave blank normally.
CLIENT_NAME=
CLIENT_DOMAIN=
CLIENT_VERTICAL=
CLIENT_PRIMARY_COLOR=
CLIENT_BRAND_VOICE_FILE=
